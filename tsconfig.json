{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "strict": true,
    "declaration": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "removeComments": true,
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
