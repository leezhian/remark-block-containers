{
  "name": "remark-block-containers",
  "version": "2.0.0",
  "description": "remark 插件-用于创建自定义容器，允许添加标题、id或样式类",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "npm run prebuild && tsc && npm run build:css",
    "build:css": "sass --style=compressed src/index.scss dist/index.css",
    "lint": "tsc --noEmit && oxlint src",
    "lint-fix": "oxlint --fix src",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leezhian/remark-block-containers.git"
  },
  "bugs": {
    "url": "https://github.com/leezhian/remark-block-containers.git/issues"
  },
  "homepage": "https://github.com/leezhian/remark-block-containers",
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css": "./dist/index.css",
    "./useCodeGroups": {
      "types": "./dist/useCodeGroups.d.ts",
      "module": "./dist/useCodeGroups.js",
      "default": "./dist/useCodeGroups.js"
    }
  },
  "keywords": [
    "remark",
    "remark-plugin",
    "remark-block",
    "remark-containers",
    "remark-block-containers"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "author": "kim",
  "license": "MIT",
  "dependencies": {
    "nanoid": "^5.0.1",
    "unist-util-find-after": "^5.0.0",
    "unist-util-find-between": "^1.2.3",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.0",
    "dedent": "^1.5.1",
    "mdast": "^3.0.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.0.3",
    "rehype-stringify": "^10.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "sass": "^1.68.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.3",
    "vitest": "^5.1.0"
  }
}
